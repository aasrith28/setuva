# Environment Configuration for ApplyRight
# Copy to .env for local development

NODE_ENV=development
PORT=3000

# Database Connection (PostgreSQL in production, SQLite for local testing)
# Example PostgreSQL: postgresql://applyright_user:password@localhost:5432/applyright?schema=public
# Example SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT / Session Secret (minimum 32 random characters in production)
JWT_SECRET="development-insecure-secret-key-at-least-32-chars-long"

# AI Provider API Configuration (Optional - fallback mock provider used when unset)
# GEMINI_API_KEY="your-gemini-api-key"
# AI_PROVIDER="mock" # or "gemini"

# Email Configuration (Optional - for reminders)
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="noreply@example.com"
# SMTP_PASS="placeholder-password"
# SMTP_FROM="ApplyRight <noreply@applyright.org>"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
